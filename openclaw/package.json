{
  "name": "daikin-cli",
  "version": "1.0.3",
  "description": "OpenClaw plugin for Daikin One+ thermostats",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "files": [
    "src/",
    "skills/",
    "openclaw.plugin.json",
    "dist/"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "daikin",
    "thermostat",
    "hvac",
    "home-automation"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@shahine.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarshahine/daikin-cli.git",
    "directory": "openclaw"
  },
  "homepage": "https://github.com/omarshahine/daikin-cli#readme",
  "bugs": {
    "url": "https://github.com/omarshahine/daikin-cli/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "plugin:check": "npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "main": "./dist/src/index.js"
}
